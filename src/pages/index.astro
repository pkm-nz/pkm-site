---
import PAGES from "../data/pages.json";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Entry from "../components/Entry.astro";
import { getProjects, getArt, getUpdates } from "../lib/content";
const projects = await getArt();
const updates = (await getUpdates()).slice(0, 3);
const byId = Object.fromEntries((await getProjects()).map(p => [p.id, p]));
---
<Base nav="home">
  <section class="intro">
    <h1>{PAGES.home.heading}<span>{PAGES.home.subheading}</span></h1>
    <p class="lede">{PAGES.home.intro}</p>
  </section>
  <section style="display:grid;gap:18px">
    <div class="sechead"><h2>{PAGES.home.projectsHeading}</h2><span class="eyebrow">{projects.length} projects</span></div>
    <div class="grid">{projects.map(p => <Card p={p} />)}</div>
  </section>
  {updates.length > 0 && (
    <section style="display:grid;gap:8px">
      <div class="sechead"><h2>{PAGES.home.updatesHeading}</h2><a href="/updates/">All updates →</a></div>
      <div class="feed">{updates.map(u => byId[u.data.project] && <Entry u={u} p={byId[u.data.project]} />)}</div>
    </section>
  )}
</Base>

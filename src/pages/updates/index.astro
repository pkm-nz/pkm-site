---
import { inline, plain } from "../../lib/inline";
import { MENU } from "../../site.config";
import PAGES from "../../data/pages.json";
import Base from "../../layouts/Base.astro";
import Entry from "../../components/Entry.astro";
import Subscribe from "../../components/Subscribe.astro";
import { getProjects, getUpdates } from "../../lib/content";
const projects = await getProjects();
const updates = await getUpdates();
const byId = Object.fromEntries(projects.map(p => [p.id, p]));
---
<Base title={MENU.updates} nav="updates" description={plain(PAGES.updates.intro)}>
  <section class="phead"><span class="eyebrow">{MENU.updates}</span><h1>{PAGES.updates.heading}</h1>
    <p class="lede" set:html={inline(PAGES.updates.intro)} /></section>
  <section style="display:grid;gap:12px">
    <div class="feed">{updates.map(u => byId[u.data.project] && <Entry u={u} p={byId[u.data.project]} />)}</div>
  </section>
  <Subscribe />
</Base>

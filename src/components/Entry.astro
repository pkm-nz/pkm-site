---
import type { Project, Update } from "../lib/content";
import { paStyle, fullTitle, fmtDate, isoDate } from "../lib/content";
import Cover from "./Cover.astro";
const { u, p } = Astro.props as { u: Update; p: Project };
const n = u.data.comments.length;
---
<a class="entry pa" href={`/updates/${u.id}/`} style={paStyle(p)} data-project={p.id}>
  <time datetime={isoDate(u.data.date)}>{fmtDate(u.data.date)}</time>
  <div class="txt">
    <span class="tag">{fullTitle(p)} · {u.data.stage}</span>
    <h3>{u.data.title}</h3>
    <p>{u.data.excerpt}</p>
    {n > 0 && <span class="ccount">{n} comment{n > 1 ? "s" : ""}</span>}
  </div>
  {u.data.image
    ? <div class="thumb whole"><img src={u.data.image} alt="" loading="lazy" decoding="async" /></div>
    : <div class="thumb"><Cover p={p} /></div>}
</a>

---
import type { Project } from "../lib/content";
import { paStyle, fullTitle } from "../lib/content";
import Stage from "./Stage.astro";
import Cover from "./Cover.astro";
const { p } = Astro.props as { p: Project };
const d = p.data;
---
<a class="card pa" href={`/projects/${p.id}/`} style={paStyle(p)}>
  <div class="art"><Cover p={p} /></div>
  <div class="body">
    <div class="meta"><span class="kind">{d.kind}</span><Stage stage={d.stage} /></div>
    <h3>{fullTitle(p)}</h3>
    <p>{d.summary}</p>
    {d.mode === "digital" && <span class="play">▶ Play it here</span>}
    {d.mode === "model" && d.embed && <span class="play">◇ Explore the 3D model</span>}
  </div>
</a>

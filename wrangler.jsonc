// Cloudflare settings: the built site in dist/ is served as static files,
// and worker/index.js sends the contact and comment forms as email.
// The address messages go to is the MAIL_TO secret, set in the Cloudflare dashboard
// (Workers → pkm-site → Settings → Variables and Secrets) so it stays out of this public repo.
{
  "name": "pkm-site",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "MAILER" }]
}
